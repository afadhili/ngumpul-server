{
    "name": "ngumpul-server",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@12.22.0",
    "type": "module",
    "exports": {
        "./rpc": { "types": "./dist/app.d.ts" }
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json && node scripts/resolve-esm-imports.mjs",
        "check:rpc": "tsc --noEmit --strict --skipLibCheck --module NodeNext --target ES2022 scripts/check-rpc-types.ts",
        "start": "node dist/server.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1175.0",
        "@aws-sdk/s3-presigned-post": "^3.1175.0",
        "@aws-sdk/s3-request-presigner": "^3.1175.0",
        "@better-auth/drizzle-adapter": "^1.7.27",
        "@better-auth/electron": "1.7.27",
        "@better-auth/expo": "1.7.27",
        "@better-auth/infra": "0.4.30",
        "@hono/node-server": "^2.1.11",
        "@scalar/api-reference": "^1.84.0",
        "@scalar/hono-api-reference": "^0.12.25",
        "better-auth": "^1.7.27",
        "dotenv": "^17.2.3",
        "drizzle-kit": "1.0.0-rc.6",
        "drizzle-orm": "^1.0.0-rc.6",
        "hono": "^4.10.6",
        "hono-openapi": "^1.6.0",
        "json-schema-to-ts": "^3.1.1",
        "livekit-server-sdk": "2.20.1",
        "nodemailer": "^10.6.1",
        "openapi-types": "^12.1.3",
        "pg": "^8.16.3",
        "redis": "^6.3.1",
        "ws": "^8.23.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.15.5",
        "@types/ws": "^8.18.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
