NODE_ENV=development
PORT=3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=localhost
# The app container reads the *_DOCKER values instead of SMTP_HOST/SMTP_PORT.
# Keep them in sync with the real provider (and SMTP_SECURE with its port).
SMTP_HOST_DOCKER=mailpit
SMTP_PORT=1025
SMTP_PORT_DOCKER=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Ngumpul <no-reply@localhost>
POSTGRES_DB=pbp_server
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
# Use localhost for running the API on your host machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pbp_server
# Use the Compose service name when running the API in Docker.
DATABASE_URL_DOCKER=postgresql://postgres:postgres@db:5432/pbp_server
REDIS_URL=redis://localhost:6379
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=ngumpuldevkey
LIVEKIT_API_SECRET=replace-with-a-random-livekit-secret
# Local S3-compatible storage (MinIO). In production, point S3_ENDPOINT and
# S3_PUBLIC_ENDPOINT at your S3 provider and use a least-privilege access key.
S3_BUCKET=pbp-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=pbpminio
S3_SECRET_ACCESS_KEY=pbp-minio-local-secret-change-me-32
S3_AUTO_CREATE_BUCKET=true
