NODE_ENV=development
PORT=3000

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_EXPO_SCHEME=ngumpul
BETTER_AUTH_ELECTRON_SCHEME=id.my.afadhili.ngumpul
BETTER_AUTH_API_KEY=
# Gunakan daftar origin HTTP(S) yang dipisahkan koma untuk beberapa client.
CORS_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=localhost
SMTP_HOST_DOCKER=mailpit
SMTP_PORT=1025
SMTP_PORT_DOCKER=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Ngumpul <no-reply@localhost>

POSTGRES_DB=pbp_server
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pbp_server
DATABASE_URL_DOCKER=postgresql://postgres:postgres@db:5432/pbp_server

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=ngumpuldevkey
LIVEKIT_API_SECRET=replace-with-a-random-livekit-secret

S3_BUCKET=pbp-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=ngumpulrustfs
S3_SECRET_ACCESS_KEY=ngumpul-rustfs-local-secret-change-me-32
S3_AUTO_CREATE_BUCKET=true

SMOKE_BASE=http://localhost:3000